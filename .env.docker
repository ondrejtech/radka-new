# Zkopíruj tento soubor jako .env a vyplň hodnoty
# cp .env.docker .env

APP_NAME="Techdomov"
APP_ENV=production
APP_KEY=                          # vygeneruj: docker compose exec app php artisan key:generate
APP_DEBUG=false
APP_URL=https://techdomov.eu

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Databáze ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                        # název docker-compose service
DB_PORT=3306
DB_DATABASE=techdomov
DB_USERNAME=techdomov
DB_PASSWORD=ZMEN_HESLO_DB
DB_ROOT_PASSWORD=ZMEN_HESLO_ROOT  # pouze pro MySQL kontejner

# ── Session / Cache / Queue ────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Mail ───────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@techdomov.eu"
MAIL_FROM_NAME="Techdomov"

VITE_APP_NAME="Techdomov"
